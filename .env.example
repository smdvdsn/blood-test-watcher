# Copy this file to .env and fill in your values. .env is ignored by git, so it
# never ends up in the (public) repo. Set whichever notification channels you use.

# ntfy: the topic name you subscribed to in the ntfy app
NTFY_TOPIC=

# WhatsApp via CallMeBot: your number in international format, and the API key
# CallMeBot sent you
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# Optional: only report cancellations starting within this many hours
# WINDOW_HOURS=48
